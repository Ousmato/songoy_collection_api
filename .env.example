# Copy this file to .env on the VPS. Do not commit the resulting .env file.
# Use an absolute host path for persistent uploaded files.
APP_HOST_PORT=8080
APP_UPLOADS_DIR=/srv/songoycollection/uploads

# MySQL connection. DB_HOST can be host.docker.internal when MySQL is installed
# directly on the VPS; otherwise use the database server hostname/IP.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=songoycollection
DB_USER=change-me
DB_PASSWORD=change-me

# Public origins allowed to call the Angular API.
CORS_ALLOWED_ORIGINS=https://example.com

# Optional Spring configuration.
SERVER_PORT=8080
DEFAULT_SUPER_ADMIN_NOM=SUPER
DEFAULT_SUPER_ADMIN_PRENOM=ADMIN
DEFAULT_SUPER_ADMIN_TELEPHONE=76000000
DEFAULT_SUPER_ADMIN_ADRESSE=Bamako

# Required business thresholds. Replace each value with the approved numeric value
# before deploying; no defaults exist in the application for these properties.
STOCK_SEUIL_ALERTE_UNITE=REPLACE_WITH_NUMBER
STOCK_SEUIL_CRITIQUE_UNITE=REPLACE_WITH_NUMBER
STOCK_SEUIL_ALERTE_METRE=REPLACE_WITH_NUMBER
STOCK_SEUIL_CRITIQUE_METRE=REPLACE_WITH_NUMBER
STOCK_SEUIL_ALERTE_PAGNE=REPLACE_WITH_NUMBER
STOCK_SEUIL_CRITIQUE_PAGNE=REPLACE_WITH_NUMBER
STOCK_SEUIL_ALERTE_CARTON=REPLACE_WITH_NUMBER
STOCK_SEUIL_CRITIQUE_CARTON=REPLACE_WITH_NUMBER
STOCK_SEUIL_ALERTE_PAIRE=REPLACE_WITH_NUMBER
STOCK_SEUIL_CRITIQUE_PAIRE=REPLACE_WITH_NUMBER
